{
  "name": "@joshbochu/pi-grok-build-ui",
  "version": "0.3.0",
  "description": "PiGrokBuild UI: an unofficial Grok Build presentation layer for Pi",
  "type": "module",
  "scripts": {
    "test": "node --test \"extensions/lib/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "author": "joshbochu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshbochu/pi-grok-build-ui.git"
  },
  "homepage": "https://github.com/joshbochu/pi-grok-build-ui#readme",
  "bugs": {
    "url": "https://github.com/joshbochu/pi-grok-build-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "extensions",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pi-grok-build-ui-preview": "bin/pi-grok-build-ui-preview"
  },
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi",
    "grok-build-ui",
    "grok-build",
    "grok",
    "coding-agent",
    "tui",
    "ui",
    "oscura-midnight",
    "theme",
    "skin"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-grok-build-ui.ts"
    ],
    "themes": [
      "./themes/oscura-midnight.json"
    ]
  }
}
